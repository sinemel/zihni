# --- Yerel Docker Postgres için (docker-compose.yml ile) ---
# DATABASE_URL="postgresql://kognita:kognita_dev_password@localhost:5432/kognita"
# DIRECT_URL="postgresql://kognita:kognita_dev_password@localhost:5432/kognita"

# --- Supabase projeniz (bmanncnbfvorlltwdvic) için ---
# Şifreyi ve region'ı Supabase Dashboard > Project Settings > Database > Connection string
# sayfasından alıp aşağıdaki [PASSWORD] ve [REGION] yerlerine SİZ yazın.
# Prisma Client (uygulama zamanı) — Transaction Pooler, port 6543:
DATABASE_URL="postgresql://postgres.bmanncnbfvorlltwdvic:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Prisma CLI (migration'lar) — Direct connection, port 5432:
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.bmanncnbfvorlltwdvic.supabase.co:5432/postgres"

# --- Diğer ---
JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-too"
NODE_ENV="development"
APP_URL="http://localhost:3000"

# --- iyzico (Sandbox) ---
# API anahtarlarını iyzico sandbox panelinden alıp SİZ doldurun; asla commit etmeyin.
IYZICO_API_KEY="[SANDBOX_API_KEY]"
IYZICO_SECRET_KEY="[SANDBOX_SECRET_KEY]"
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"
# Sandbox panelinde ürün + fiyat planı oluşturup referans kodlarını girin:
IYZICO_PLAN_PRO_REF="[PRO_PRICING_PLAN_REF]"
IYZICO_PLAN_EXPERT_REF="[EXPERT_PRICING_PLAN_REF]"


# Görev 5b — CORS: virgülle ayrılmış izinli origin listesi (joker YASAK)
CORS_ORIGINS=http://localhost:3001
# Üretimde: CORS_ORIGINS=https://zihni.com,https://www.zihni.com
